AZURE_LOCATION=koreacentral
MANAGED_ENVIRONMENT_ID=/subscriptions/YOUR_SUBSCRIPTION/resourceGroups/rg-insu-demo/providers/Microsoft.App/managedEnvironments/insu-demo
PULL_IDENTITY_ID=/subscriptions/YOUR_SUBSCRIPTION/resourceGroups/rg-insu-demo/providers/Microsoft.ManagedIdentity/userAssignedIdentities/insu-image-pull
ACR_SERVER=YOUR_REGISTRY.azurecr.io
BACKEND_IMAGE=YOUR_REGISTRY.azurecr.io/insu-api:REVIEWED_COMMIT
FRONTEND_IMAGE=YOUR_REGISTRY.azurecr.io/insu-web:REVIEWED_COMMIT
FRONTEND_ORIGIN=https://insu-web.YOUR_ENVIRONMENT_DOMAIN.azurecontainerapps.io
MONGO_PROD=mongodb+srv://DEMO_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/insu-demo
SECRET_TOKEN=REPLACE_WITH_A_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
